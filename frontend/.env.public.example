# Frontend settings for the public ngrok build (see docs/DEPLOYMENT_PUBLIC.md).
# Copy to .env.public.local (gitignored via *.local) and fill in your domain.
# Loaded by `vite build --mode public` / `vite preview --mode public`,
# which start_public.ps1 runs. Plain `npm run dev` does NOT read this file.

# Send every API call to the same origin under /api (proxied to the backend).
VITE_API_BASE_URL=/api

# Your ngrok dev domain, hostname only (no https://). Comma-separate to add more.
FRONTEND_ALLOWED_HOSTS=your-assigned-name.ngrok-free.app
