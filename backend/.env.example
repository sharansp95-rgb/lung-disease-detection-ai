# Required for signed sessions. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret

# Optional Groq report and chat generation. The app uses safe template fallbacks when unset.
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional Google OAuth sign-in.
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret

# Optional SMTP delivery for verification and password-reset emails.
GMAIL_ADDRESS=your_email@example.com
GMAIL_APP_PASSWORD=replace_with_your_gmail_app_password

# Local development URLs and public-origin allowlist.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
ALLOWED_PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides.
DB_PATH=app.db
MODALITY_GATE_CONFIDENCE_THRESHOLD=0.90

# Optional Postgres (e.g. Neon) instead of the SQLite file at DB_PATH. Unset = SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Direct peers whose X-Forwarded-For / X-Forwarded-Host are trusted (IPs or CIDRs).
# Default 127.0.0.1 = the local Vite proxy. docker-compose.yml sets the Caddy container's address.
# TRUSTED_PROXY_IPS=127.0.0.1
