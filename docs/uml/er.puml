@startuml er
!include _style.iuml
skinparam linetype ortho
entity USERS {
  * id : INTEGER <<PK>>
  --
  email : TEXT UNIQUE
  password_hash : TEXT (bcrypt)
  email_verified : INTEGER
  google_id : TEXT UNIQUE
  display_name : TEXT
  created_at : TEXT
}
entity TOKENS {
  * id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  token : TEXT UNIQUE
  type : 'verify' | 'reset'
  expires_at : TEXT
  used : INTEGER
}
entity SCANS {
  * id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  modality : 'xray' | 'ct'
  predicted_class : TEXT
  confidence : REAL
  class_probabilities : JSON
  heatmap_png_base64 : TEXT
  report, report_source : TEXT
  created_at : TEXT
}
USERS ||--o{ TOKENS : has
USERS ||--o{ SCANS : owns
@enduml
